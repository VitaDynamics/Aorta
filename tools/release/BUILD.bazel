load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

# Release-artifact legal texts shared by the C++ SDK bundle and the wheels.
exports_files([
    "LICENSE",
    "NOTICE",
])

# Generated in the release job before Bazel; absent evidence fails packaging.
py_binary(
    name = "gen_third_party_notices",
    srcs = ["gen_third_party_notices.py"],
)

# The public wheel consumes this output. Release jobs can stage this input themselves.
genrule(
    name = "collect_third_party_licenses",
    srcs = [
        "//:Cargo.toml",
        "//:Cargo.lock",
        "//.cargo:config.toml",
        "about.toml",
        "//core:license_workspace_sources",
        "//rust:license_workspace_sources",
        "//sync:license_workspace_sources",
        "//tools/aorta-cbindgen:license_workspace_sources",
        "//tools/aorta-cli:license_workspace_sources",
        "//tools/aorta-foxglove-bridge:license_workspace_sources",
        "//tools/aorta-introspect:license_workspace_sources",
        "//tools/aorta-play:license_workspace_sources",
        "//tools/aorta-record:license_workspace_sources",
        "//tools/aorta-sysmon:license_workspace_sources",
        "//tools/aorta-trace-tui:license_workspace_sources",
        "//tools/aorta-trace2perfetto:license_workspace_sources",
        "//tools/aorta-tui:license_workspace_sources",
        "//tools/zenohd:license_workspace_sources",
    ],
    outs = ["certification/third_party_licenses.json"],
    tools = [":gen_third_party_notices"],
    cmd = "test \"$$(cargo about --version)\" = \"cargo-about 0.9.2\" && $(execpath :gen_third_party_notices) --collect --manifest $(location //:Cargo.toml) --lock $(location //:Cargo.lock) --config $(location about.toml) --licenses $@",
)

# The Python SDK wheel's notices: the same evidence and policy, restricted to
# the crates `cargo tree -e normal --target <triple> -p aorta_core` reaches —
# what the libaorta_core bundled in the wheel links. The triple follows the
# wheel's own platform selection (//python config_settings), and only the
# Linux wheels dynamically link the glibc/libstdc++ runtimes RUNTIME-NOTICES.md
# describes. The zstd-sys BSD-3 notice arrives through about.toml's clarify
# entry, so it is part of the evidence rather than bolted on here.
genrule(
    name = "aorta_sdk_wheel_third_party_notices",
    srcs = [
        "certification/third_party_licenses.json",
        "about.toml",
        "//:Cargo.lock",
        "RUNTIME-NOTICES.md",
    ],
    outs = ["aorta_sdk_wheel/THIRD_PARTY_NOTICES.md"],
    tools = [":gen_third_party_notices"],
    cmd = "$(execpath :gen_third_party_notices) --licenses $(location certification/third_party_licenses.json) --lock $(location //:Cargo.lock) --config $(location about.toml) --output $@ --target " + select({
        "//python:linux_aarch64": "aarch64-unknown-linux-gnu --runtime-notices $(location RUNTIME-NOTICES.md)",
        "//python:linux_x86_64": "x86_64-unknown-linux-gnu --runtime-notices $(location RUNTIME-NOTICES.md)",
        "//python:macos_aarch64": "aarch64-apple-darwin",
        "//python:macos_x86_64": "x86_64-apple-darwin",
        "//conditions:default": "x86_64-unknown-linux-gnu --runtime-notices $(location RUNTIME-NOTICES.md)",
    }),
)
