load("@aorta_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/aorta-introspect:rust_link_flags.bzl", "aorta_introspect_linux_rustc_flags")

rust_library(
    name = "aorta_record",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "aorta_record",
    edition = "2021",
    deps = all_crate_deps(normal = True) + [
        "//core:aorta_core",
        "//tools/aorta-introspect:aorta_introspect",
    ],
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "aorta-record",
    srcs = ["src/main.rs"],
    crate_name = "aorta_record_bin",
    edition = "2021",
    rustc_flags = aorta_introspect_linux_rustc_flags(),
    deps = all_crate_deps(normal = True) + [
        ":aorta_record",
        "//tools/aorta-introspect:aorta_introspect_ffi",
    ],
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "basic_sink",
    srcs = ["examples/basic_sink.rs"],
    crate_name = "basic_sink",
    edition = "2021",
    deps = all_crate_deps(normal = True) + [
        ":aorta_record",
        "//core:aorta_core",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "aorta_record_test",
    crate = ":aorta_record",
    deps = ["//tools/aorta-introspect:aorta_introspect_ffi"],
    rustc_flags = aorta_introspect_linux_rustc_flags(),
)

sh_test(
    name = "aorta_record_smoke_test",
    srcs = ["tests/record_e2e.sh"],
    args = [
        "--record-bin=$(location :aorta-record)",
        "--talker-bin=$(location //rust/examples:cli_talker)",
        "--profile=quick",
    ],
    data = [
        ":aorta-record",
        "//rust/examples:cli_talker",
    ],
    tags = [
        "manual",
        "no-sandbox",
    ],
    timeout = "moderate",
)

sh_test(
    name = "aorta_record_regression_test",
    srcs = ["tests/record_e2e.sh"],
    args = [
        "--record-bin=$(location :aorta-record)",
        "--talker-bin=$(location //rust/examples:cli_talker)",
        "--profile=full",
    ],
    data = [
        ":aorta-record",
        "//rust/examples:cli_talker",
    ],
    tags = [
        "manual",
        "no-sandbox",
    ],
    timeout = "long",
)

# Expose `Cargo.toml` to Bazel so `crate.from_cargo(manifests=[...])`
# (MODULE.bazel) can read this workspace member when resolving
# `workspace = true` zenoh inheritance.
exports_files(["Cargo.toml"])

filegroup(
    name = "license_workspace_sources",
    srcs = glob(["**/*"]),
    visibility = ["//tools/release:__pkg__"],
)
