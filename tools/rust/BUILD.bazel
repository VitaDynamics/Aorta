package(default_visibility = ["//visibility:public"])

exports_files([
    "discover_bazel_rust_project.sh",
    "generate_rust_project.sh",
])

config_setting(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "macos_aarch64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

alias(
    name = "rust_cargo",
    actual = select({
        ":linux_aarch64": "@rust_linux_aarch64__aarch64-unknown-linux-gnu__stable_tools//:cargo",
        ":linux_x86_64": "@rust_linux_x86_64__x86_64-unknown-linux-gnu__stable_tools//:cargo",
        ":macos_aarch64": "@rust_macos_aarch64__aarch64-apple-darwin__stable_tools//:cargo",
        ":macos_x86_64": "@rust_macos_x86_64__x86_64-apple-darwin__stable_tools//:cargo",
        "//conditions:default": "@rust_linux_aarch64__aarch64-unknown-linux-gnu__stable_tools//:cargo",
    }),
)

alias(
    name = "rust_rustc",
    actual = select({
        ":linux_aarch64": "@rust_linux_aarch64__aarch64-unknown-linux-gnu__stable_tools//:rustc",
        ":linux_x86_64": "@rust_linux_x86_64__x86_64-unknown-linux-gnu__stable_tools//:rustc",
        ":macos_aarch64": "@rust_macos_aarch64__aarch64-apple-darwin__stable_tools//:rustc",
        ":macos_x86_64": "@rust_macos_x86_64__x86_64-apple-darwin__stable_tools//:rustc",
        "//conditions:default": "@rust_linux_aarch64__aarch64-unknown-linux-gnu__stable_tools//:rustc",
    }),
)
