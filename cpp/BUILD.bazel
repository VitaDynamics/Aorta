# Wires cpp/test/expectfail/run_expectfail.sh
# (the ~20-TU expect-fail compile suite over the REAL exported flow headers +
# the real generated action-schema headers) into Bazel/CI instead of leaving
# it a manual-only script assuming a local `bazel-bin` layout.
#
# The script itself keeps its exact needle/check_old_order/abort-lint gating
# logic (see the file for that — untouched here); this target only supplies
# the compiler and generated-header locations Bazel-side:
#   * `toolchains` gives access to the cc toolchain's $(CC) predefined Make
#     variable — the resolved, executable compiler entry point for whatever
#     toolchain this invocation configured (default GCC, or Clang under
#     `--repo_env=CC=clang --repo_env=CXX=clang++`; see aorta-bazel-test.yml).
#   * `data` brings the compiler's own files, the cbindgen `aorta.h`, the
#     generated action-schema headers (transitively, via //message:
#     cpp_generated + the flow_resume_probe_msg.h wrapper), the flatbuffers
#     runtime headers, and the real `cpp/include/aorta/*` sources into the
#     runfiles tree the script runs from — Bazel mirrors generated files
#     there at their logical repo-relative path (no `bazel-bin/` prefix),
#     which is exactly what AORTA_BAZEL_RUNFILES=1 in the script expects.
#   * FLATBUFFERS_H_FILE anchors the one path Bazel's runfiles layout can't
#     give a stable repo-relative guess for (the Bzlmod-canonicalized
#     `@flatbuffers` repo directory name) — $(location) resolves it
#     correctly regardless of that name.
# The AST resume-site lint: every
# coroutine_handle::resume() in the flow headers must sit inside an
# inventoried delivery thunk; C-API post symbols are count-pinned.
# Includes a RED self-test pinning the gate itself. Wiring mirrors
# :flow_expectfail_test below.
sh_test(
    name = "flow_resume_lint_test",
    srcs = ["lint/run_flow_resume_lint.sh"],
    data = [
        "lint/flow_resume_allowlist.txt",
        "lint/flow_resume_lint.py",
        "//core:aorta_ffi_header",
        "//message/bindings/cpp:flow_resume_probe_msg_cc_wrapper_hdr",
        "//message:cpp_generated",
        "//message/schemas/action/example:all_schema_meta_cpp",
        "@flatbuffers//:public_headers",
        "@flatbuffers//:include/flatbuffers/flatbuffers.h",
        "@bazel_tools//tools/cpp:current_cc_toolchain",
    ] + glob(["include/aorta/**"]),
    toolchains = ["@bazel_tools//tools/cpp:current_cc_toolchain"],
    env = {
        "CXX": "$(CC)",
        "AORTA_BAZEL_RUNFILES": "1",
        "FLATBUFFERS_H_FILE": "$(location @flatbuffers//:include/flatbuffers/flatbuffers.h)",
    },
    # The clang AST-dump over the probe TU (every flow header) grew with
    # the SerialDomain work; loaded CI runners exceeded medium's 300s
    # (first branch CI run) — the walk is single-threaded and safe, it
    # just needs the room.
    size = "medium",
    timeout = "eternal",
)

