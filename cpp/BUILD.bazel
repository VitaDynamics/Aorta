# NOTE: the former `gmock_impl` cc_library was REMOVED here.
# gtest v1.17 integrates GoogleMock, and `//src/third_party/gtest:gtest`
# already globs `googlemock/src/*.cc` (gmock-matchers.cc → `kUnused`,
# gmock-spec-builders.cc → Sequence ThreadLocal, etc.). gmock_impl
# recompiled the SAME five sources into a SECOND shared library, so every
# mock-linked test loaded two copies of gmock's globals + thread-local
# singletons. That duplication was the single root cause of three
# sanitizer symptoms on the 8 mock-linked targets:
#   * ASAN odr-violation on `kUnused` at load (detect_odr_violation=2)
#   * ASAN heap-use-after-free in gmock Sequence ThreadLocal teardown
#     (when the odr check was relaxed — the bug just moved to teardown)
#   * UBSAN static-destructor SIGSEGV (double-destroy of the same globals)
# Depend on `//src/third_party/gtest:gtest` (or its `:gmock` alias) for
# gmock; do NOT reintroduce a second library that compiles googlemock/src.

cc_library(
    name = "aorta_cpp_headers",
    # flow_watch.hpp is the one .hpp in the C++17 baseline: header-only
    # Ring sugar over the C ABI, no coroutines (the glob only catches .h).
    hdrs = glob([
        "include/aorta/*.h",
        "include/aorta/detail/*.h",
    ]) + ["include/aorta/flow_watch.hpp"],
    includes = ["include"],
    deps = [
        "//core:aorta_ffi_headers",
        "//message:fbs_schema_aorta_base_cpp_lib",
        "//message:fbs_schema_action_common_cpp_lib",
    ],
    visibility = ["//visibility:public"],
)

# Every header under `include/` ships, recursively: `aorta/aorta.h` pulls in
# `aorta/detail/reentrancy_check.h`, so a top-level-only glob produces a bundle
# whose public header does not compile.
filegroup(
    name = "aorta_cpp_public_headers",
    srcs = glob([
        "include/**/*.h",
        "include/**/*.hpp",
    ]),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "aorta_cpp",
    # QoS preset bodies live in the shared source list (not headers),
    # so only the compiled SDK targets propagate the Core FFI dependency.
    srcs = _AORTA_CPP_SRCS,
    deps = [
        ":aorta_cpp_headers",
        "//core:aorta_core_linkopts",
        "//core:aorta_ffi_headers",
        "//message:fbs_schema_aorta_base_cpp_lib",
    ] + select({
        # Cross-language TSAN lane (--config=tsan-xlang) links the cargo-built
        # instrumented FFI staticlib instead of the uninstrumented (stable-1.92)
        # rules_rust lib, so a single process has BOTH sides TSAN-instrumented.
        # Every other config — normal / asan / ubsan / tsan-clang(mock) — keeps
        # the real lib, so this select is invisible outside the xlang lane.
        "//core:tsan_xlang": ["//core:aorta_core_ffi_tsan_prebuilt"],
        "//conditions:default": ["//core:aorta_core_ffi"],
    }),
    visibility = ["//visibility:public"],
)

# Release-only static SDK library.
#
# `--config=release` compiles with `-flto=auto`, which makes `libaorta_cpp.a`
# unusable outside the exact GCC major version that built it: GNU ld's LTO
# plugin claims the `.gnu.lto_*` sections in preference to any machine code, so
# a GCC 11 consumer (Ubuntu 22.04 / Humble) dies with
# `lto1: bytecode stream ... generated with LTO version 13.1 instead of the
# expected 11.3`. `-ffat-lto-objects` does not help — the plugin still picks the
# IR. A redistributable archive must therefore carry plain objects, so this
# target opts out of LTO (target copts win over `--copt`). The in-repo
# `:aorta_cpp` keeps LTO for the publish hot path; only the shipped archive
# differs, and the membership gate rejects any LTO section in it.
cc_library(
    name = "aorta_cpp_release_static",
    srcs = _AORTA_CPP_SRCS,
    copts = ["-fno-lto"],
    linkopts = select({
        "@platforms//os:macos": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["-fno-lto"],
    }),
    deps = [
        ":aorta_cpp_headers",
        "//core:aorta_core_linkopts",
        "//core:aorta_ffi_headers",
        "//message:fbs_schema_aorta_base_cpp_lib",
    ],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# Release-only shared SDK library. It links against the Core cdylib so a
# consumer process has exactly one Core runtime when using Aorta::cpp_shared.
cc_library(
    name = "aorta_cpp_shared_objects",
    srcs = _AORTA_CPP_SRCS,
    alwayslink = True,
    deps = [
        ":aorta_cpp_headers",
        "//core:aorta_core_cdylib",
        "//core:aorta_core_linkopts",
        "//core:aorta_ffi_headers",
        "//message:fbs_schema_aorta_base_cpp_lib",
    ],
    tags = ["manual"],
)

cc_shared_library(
    name = "aorta_cpp_shared",
    deps = [":aorta_cpp_shared_objects"],
    shared_lib_name = select({
        "@platforms//os:macos": "libaorta_cpp_sdk.dylib",
        "@platforms//os:windows": "aorta_cpp_sdk.dll",
        "//conditions:default": "libaorta_cpp_sdk.so",
    }),
    user_link_flags = select({
        "@platforms//os:macos": ["-Wl,-install_name,@rpath/libaorta_cpp.dylib"],
        "@platforms//os:windows": [],
        "//conditions:default": ["-Wl,-soname,libaorta_cpp.so"],
    }),
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

