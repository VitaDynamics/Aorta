# Runnable demo of subscriber-callback panic
# isolation (paired with `talker_simple` or `talker`). The
# subscriber's callback throws after the first few messages; the
# process stays alive because the dispatcher in
# `cpp/src/subscriber.cc` catches at the `extern "C"` boundary
# (the dispatcher is declared `noexcept`).
cc_binary(
    name = "throwing_callback_listener",
    srcs = ["throwing_callback_listener.cc"],
    deps = [
        "//cpp:aorta_cpp",
        "//message:demo_chat_msg_cc",
    ],
)

