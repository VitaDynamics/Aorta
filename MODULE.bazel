# perf-event2 is aorta-sysmon's only external crate outside what
# `aorta_core` already pulls in. It links libc's
# perf_event_open syscall, which only exists on Linux — the collector
# `tools/aorta-sysmon/src/collector/perf.rs` is `cfg(target_os = "linux")`
# gated, so the crate is only actually pulled on Linux toolchains via
# `aorta-sysmon`'s `Cargo.toml` target-conditional dep. Listing it here
# keeps `@aorta_crates//:perf-event2` resolvable on Linux builds.
crate.spec(
    package = "perf-event2",
    version = "0.7",
)
crate.from_cargo(
    name = "aorta_crates",
    cargo_config = "//.cargo:config.toml",
    # Bazel owns this Cargo-format lockfile. After changing Cargo dependencies,
    # regenerate it with:
    # cp Cargo.lock Cargo.bazel.lock && bazel build @aorta_crates//:srcs && bazel build @aorta_crates//:srcs
    # Cargo workspace root. `//:Cargo.toml` carries the
    # single-source-of-truth Zenoh git pin in `[workspace.dependencies]`;
    # each member manifest is listed so `workspace = true` inheritance
    # resolves inside Bazel's hermetic sandbox.
    cargo_lockfile = "//:Cargo.bazel.lock",
    manifests = [
        "//:Cargo.toml",
        "//core:Cargo.toml",
        "//rust:Cargo.toml",
        "//sync:Cargo.toml",
        "//tools/aorta-cbindgen:Cargo.toml",
        "//tools/aorta-cli:Cargo.toml",
        "//tools/aorta-foxglove-bridge:Cargo.toml",
        "//tools/aorta-introspect:Cargo.toml",
        "//tools/aorta-play:Cargo.toml",
        "//tools/aorta-record:Cargo.toml",
        "//tools/aorta-sysmon:Cargo.toml",
        "//tools/aorta-trace-tui:Cargo.toml",
        "//tools/aorta-trace2perfetto:Cargo.toml",
        "//tools/aorta-tui:Cargo.toml",
        "//tools/zenohd:Cargo.toml",
    ],
    supported_platform_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
    ],
)
use_repo(crate, "aorta_crates")

# One pip.parse per supported Python version (same hub): the hub's per-package
# alias is a select over `is_python_X` settings, and ONLY parsed versions get a
# branch — see the python.toolchain comment above for why every version in the
# consumer support matrix must be parsed, not just aorta's own 3.10 default.
# The lock is a single universal (py3-none-any) wheel, flatbuffers==25.12.19
# (pinned to the flatc/Bzlmod module version), so per-version parses cannot
# diverge in contents.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    download_only = True,
    hub_name = "aorta_py_deps",
    python_version = "3.10",
    requirements_by_platform = {
        "//python:requirements_linux_aarch64.txt": "linux_aarch64",
        "//python:requirements_linux_x86_64.txt": "linux_x86_64",
    },
)
pip.parse(
    download_only = True,
    hub_name = "aorta_py_deps",
    python_version = "3.11",
    requirements_by_platform = {
        "//python:requirements_linux_aarch64.txt": "linux_aarch64",
        "//python:requirements_linux_x86_64.txt": "linux_x86_64",
    },
)
pip.parse(
    download_only = True,
    hub_name = "aorta_py_deps",
    python_version = "3.12",
    requirements_by_platform = {
        "//python:requirements_linux_aarch64.txt": "linux_aarch64",
        "//python:requirements_linux_x86_64.txt": "linux_x86_64",
    },
)
pip.parse(
    download_only = True,
    hub_name = "aorta_py_deps",
    python_version = "3.13",
    requirements_by_platform = {
        "//python:requirements_linux_aarch64.txt": "linux_aarch64",
        "//python:requirements_linux_x86_64.txt": "linux_x86_64",
    },
)
use_repo(pip, "aorta_py_deps")
