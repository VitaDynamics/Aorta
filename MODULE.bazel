http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
http_file(
    name = "wheel_test_pip",
    dev_dependency = True,
    urls = ["https://files.pythonhosted.org/packages/29/a2/d40fb2460e883eca5199c62cfc2463fd261f760556ae6290f88488c362c0/pip-25.1.1-py3-none-any.whl"],
    sha256 = "2913a38a2abf4ea6b64ab507bd9e967f3b53dc1ede74b01b0931e1ce548751af",
    downloaded_file_path = "pip-25.1.1-py3-none-any.whl",
)

archive_override(
    module_name = "flatbuffers",
    integrity = "sha256-+BwxYrEEb+i4S5oNvdOD4k/bz4hYO5y2Ao+Q0E2QaWo=",
    strip_prefix = "flatbuffers-25.12.19",
    urls = ["https://github.com/google/flatbuffers/archive/refs/tags/v25.12.19.tar.gz"],
)

git_override(
    module_name = "hedron_compile_commands",
    commit = "4f28899228fb3ad0126897876f147ca15026151e",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor",
)

single_version_override(
    module_name = "rules_rust",
    version = "0.68.1",
    patch_strip = 1,
    patches = ["//patches:rules_rust_linux_static_link.patch"],
)

# Root-only Linux cross analysis and compilation; consumers select their own toolchains.
bazel_dep(name = "toolchains_llvm", version = "1.3.0", dev_dependency = True)
sysroot_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
sysroot_archive(
    name = "linux_aarch64_sysroot",
    dev_dependency = True,
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/278c36fe3a785d7f89fbe3f46956899a3bd49fe665f68dc667d6f626a951fcd6"],
    sha256 = "278c36fe3a785d7f89fbe3f46956899a3bd49fe665f68dc667d6f626a951fcd6",
    type = "tar.xz",
    build_file_content = "filegroup(name = 'sysroot', srcs = glob(['usr/include/**', 'usr/lib/aarch64-linux-gnu/**', 'usr/lib/gcc/**', 'lib/aarch64-linux-gnu/**', 'lib/ld-linux-aarch64.so.1']), visibility = ['//visibility:public'])",
)
linux_cross = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
linux_cross.toolchain(
    name = "linux_cross",
    llvm_version = "17.0.6",
    exec_os = "linux",
    exec_arch = "amd64",
    urls = {"": ["https://github.com/llvm/llvm-project/releases/download/llvmorg-17.0.6/clang+llvm-17.0.6-x86_64-linux-gnu-ubuntu-22.04.tar.xz"]},
    sha256 = {"": "884ee67d647d77e58740c1e645649e29ae9e8a6fe87c1376be0f3a30f3cc9ab3"},
    strip_prefix = {"": "clang+llvm-17.0.6-x86_64-linux-gnu-ubuntu-22.04"},
    stdlib = {"linux-aarch64": "dynamic-stdc++"},
)
linux_cross.sysroot(
    name = "linux_cross",
    label = "@linux_aarch64_sysroot//:sysroot",
    targets = ["linux-aarch64"],
)
use_repo(linux_cross, "linux_cross")
register_toolchains("@linux_cross//:cc-toolchain-aarch64-linux", dev_dependency = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    ignore_root_user_error = True,
    is_default = True,
    python_version = "3.10",
)

# 3.11-3.13 exist ONLY so the `aorta_py_deps` pip hub below can be parsed for
# each version an external consumer's ROOT module may default to. Bzlmod
# ignores a non-root module's `is_default` — when aorta is consumed as a
# dependency, the consumer's (or rules_python's own) default interpreter wins,
# and a hub parsed for 3.10 alone hard-fails analysis for any target whose
# codegen tool needs the pip `flatbuffers` runtime (gen_message_wrapper →
# reflection_py_lib). 3.13 is the ceiling rules_python 1.0.0 ships an
# interpreter for (the Python SDK's own 3.14 CI lane runs outside Bazel);
# consumers on newer interpreters need a rules_python upgrade here first.
# In-repo builds keep the 3.10 default above.
python.toolchain(
    ignore_root_user_error = True,
    python_version = "3.11",
)
python.toolchain(
    ignore_root_user_error = True,
    python_version = "3.12",
)
python.toolchain(
    ignore_root_user_error = True,
    python_version = "3.13",
)
use_repo(python, "python_3_10", "python_3_10_x86_64-unknown-linux-gnu")

