# Test-only, dev dependency: an EMPTY in-tree module that the schema
# composition regression driver (message/tools/tests/schema_decoupling_cases_test.py)
# overrides per case with `--override_module=aorta_schema_module_fixture=<case dir>`
# to exercise the cross-module schema gates. Bazel only accepts a command-line
# override for a module the root declares, and the root no longer declares any
# schema module of its own, so this neutral name is what the driver overrides.
# Consumers never see it: dev dependencies of a non-root module are ignored.
# See the fixture's MODULE.bazel for the full rationale.
bazel_dep(
    name = "aorta_schema_module_fixture",
    version = "0.0.0",
    dev_dependency = True,
)

local_path_override(
    module_name = "aorta_schema_module_fixture",
    path = "message/tools/tests/schema_module_fixture",
)

