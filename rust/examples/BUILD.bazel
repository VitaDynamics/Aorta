    name = "flow_demo",
    srcs = ["flow_demo.rs"],
    edition = "2021",
    deps = [
        "//rust:aorta_sdk",
        "@aorta_crates//:tokio",
    ],
)

# The Rust-plane Flow TCK emitter (test/flow_tck/SCHEMA.md). Cargo builds
# it as `--example flow_tck_emitter --features examples` (the feature is an
# empty opt-in gate — no dep or cfg differences); this target lets
# //test/flow_tck:flow_tck run both planes hermetically.
rust_binary(
    name = "flow_tck_emitter",
    srcs = ["flow_tck_emitter.rs"],
    edition = "2021",
    visibility = ["//test/flow_tck:__pkg__"],
    deps = [
        # aorta_core directly: the admission-counters / queued-server
        # scenarios drive core executor + service surfaces that the SDK
        # deliberately doesn't re-export (Cargo grants examples the SDK
        # crate's own deps; Bazel needs them spelled).
        "//core:aorta_core",
        "//rust:aorta_sdk",
        "@aorta_crates//:tokio",
    ],
)

