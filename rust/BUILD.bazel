# Lives in the Cargo-canonical `tests/` dir (so `cargo test` auto-discovers it),
# but CI is bazel-only, so without an explicit target this — the ONLY coverage of
# cross-namespace wildcard rejection (a fleet-broadcast safety guard) — never
# gated a merge. Wire it so a regression that let `*`/`**` through
# `create_client_for` fails CI instead of surfacing as an accidental fleet-wide
# RPC fan-out in production.
rust_test(
    name = "cross_namespace_sdk_test",
    srcs = ["tests/cross_namespace_sdk.rs"],
    edition = "2021",
    deps = [
        ":aorta_sdk",
        "@aorta_crates//:tokio",
    ],
    env = {
        "AORTA_TRACE_AUTO_INIT": "0",
    },
    size = "small",
)

# Same `tests/` vs `test/` glob trap as cross_namespace_sdk_test above:
# flow_sdk_surface.rs is the ONLY SDK-surface acceptance test for the Flow
# feature and lives in the Cargo-canonical `tests/` dir, so without
# an explicit target the bazel-only CI never ran it. It opens real zenoh
# sessions per test; keep libtest serial (--test-threads=1) like the core
# session-opening suites.
rust_test(
    name = "flow_sdk_surface_test",
    srcs = ["tests/flow_sdk_surface.rs"],
    edition = "2021",
    args = [
        "--test-threads=1",
    ],
    deps = [
        ":aorta_sdk",
        "@aorta_crates//:libc",
        "@aorta_crates//:tokio",
    ],
    env = {
        "AORTA_TRACE_AUTO_INIT": "0",
    },
    size = "small",
)

