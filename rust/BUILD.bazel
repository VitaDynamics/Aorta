exports_files(["BUILD.bazel"])

# Aorta-owned anchors for the Rust SDK's public third-party crate surface.
# @aorta_crates is Aorta's PRIVATE crate-universe repo name — no external
# Bzlmod consumer has that repo mapping, so a downstream repo depending on
# the SDK cannot write @aorta_crates//:tokio directly (guaranteed failure:
# Bzlmod repo names resolve per module). These aliases
# resolve in THIS package — where @aorta_crates is visible — and are the
# downstream-facing labels (same anchoring pattern as
# //message/tools:flatbuffers_rust; both anchors point at the same
# @aorta_crates targets).
#
# tokio: required for the #[tokio::main] entry point every SDK example
# uses. The SDK manifest pins the macros + rt-multi-thread features
# explicitly (rust/Cargo.toml) so the #[tokio::main] contract is owned
# by the SDK, not accidentally inherited from the in-tree CLI tools'
# feature union.
# flatbuffers: the SDK prelude re-exports flatbuffers::FlatBufferBuilder,
# so consumers building typed messages name flatbuffers types.
# bytes: the zero-copy publish_bytes path accepts `bytes::Bytes` (README
# §3.3.4); the `Into<ZBytes>` impl is bound to the exact bytes crate
# identity Aorta's zenoh links, so a consumer hub of a different version
# (or crate identity) cannot satisfy it — consumers must use this alias.
alias(
    name = "tokio",
    actual = "@aorta_crates//:tokio",
    visibility = ["//visibility:public"],
)

alias(
    name = "flatbuffers",
    actual = "@aorta_crates//:flatbuffers",
    visibility = ["//visibility:public"],
)

alias(
    name = "bytes",
    actual = "@aorta_crates//:bytes",
    visibility = ["//visibility:public"],
)

rust_library(
    name = "aorta_sdk",
    srcs = glob(["src/**/*.rs", "test/**/*.rs"]),
    crate_name = "aorta_sdk",
    edition = "2021",
    deps = all_crate_deps(normal = True) + [
        "//core:aorta_core",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "aorta_sdk_test",
    crate = ":aorta_sdk",
    # SDK lib tests mix session-opening tests and trace-state assertions in one
    # process; keep the Session::open trace auto-init hook out of the suite.
    env = {
        "AORTA_TRACE_AUTO_INIT": "0",
    },
    size = "medium",
)

# The standalone test binaries below pull schema-bound message crates
# (`//message:..._msg_rs`) that aren't Cargo deps, so they keep the
# explicit list rather than `all_crate_deps`. They link aorta_core as a
# NORMAL dependency (no cfg(test) hermetic env lockout), so each one that
# opens sessions must opt out of the Session::open trace auto-init hook
# explicitly to keep sink writes out of `bazel test`.
rust_test(
    name = "all_types_typed_publish_test",
    srcs = ["test/all_types_typed_publish_tests.rs"],
    edition = "2021",
    deps = [
        ":aorta_sdk",
        "//message:all_types_msg_rs",
        "@aorta_crates//:flatbuffers",
    ],
    env = {
        "AORTA_TRACE_AUTO_INIT": "0",
    },
    size = "small",
)

