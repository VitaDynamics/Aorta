# Perturbation test — reordering a fixture schema's
# include statements and top-level type declarations must not change the
# canonical wrapper output (in either language). The module docstring has
# details. Runs on the loader path — flatc-compiled bfbs fixtures below
# (--root-bfbs is now required), same pattern as wrapper_loader_fixture_*.
# Both variants' root schema is named `root.fbs` (in its own `original/` /
# `perturbed/` subdirectory) — the loader path derives a root-local type's
# generated-module name from `Path(root_fbs).stem`, so two DIFFERENT
# filenames (e.g. `root_original.fbs` vs `root_perturbed.fbs`) would make the
# variants differ in a real, non-ordering way (module name), defeating the
# "byte-identical regardless of ordering" assertion below for a reason
# unrelated to what this test checks.
[
    genrule(
        name = "canonical_order_fixture_{}_bfbs".format(variant),
        srcs = [
            "tests/canonical_order_fixtures/{}/root.fbs".format(variant),
            "tests/canonical_order_fixtures/{}/perturb_aorta_sys.fbs".format(variant),
            "tests/canonical_order_fixtures/{}/perturb_inc_a.fbs".format(variant),
            "tests/canonical_order_fixtures/{}/perturb_inc_b.fbs".format(variant),
        ],
        outs = ["tests/canonical_order_fixtures/{}/root.bfbs".format(variant)],
        tools = [":flatc"],
        cmd = "$(location :flatc) --binary --schema --bfbs-builtins -o $(@D) $(location tests/canonical_order_fixtures/{}/root.fbs)".format(variant),
    )
    for variant in ["original", "perturbed"]
]

