# Compiled bfbs for the gen_schema_meta
# reflection fixtures (message/tools/tests/schema_meta_fixtures/*.fbs) —
# same plain-genrule pattern as the reflection fixtures above. The
# grandchild chain and the include-typed header fixtures need `-I` for
# their `include` statements; structroot_root.fbs is deliberately NOT
# compiled (the pinned flatc rejects struct roots — its bfbs is
# synthesized at test time, see gen_schema_meta_reflection_test.py).
[
    genrule(
        name = "schema_meta_fixture_{}_bfbs".format(stem),
        srcs = ["tests/schema_meta_fixtures/{}.fbs".format(f) for f in [stem] + deps],
        outs = ["tests/schema_meta_fixtures/{}.bfbs".format(stem)],
        tools = [":flatc"],
        cmd = "$(location :flatc) --binary --schema --bfbs-builtins -o $(@D) " +
              "-I $$(dirname $(location tests/schema_meta_fixtures/{stem}.fbs)) ".format(stem = stem) +
              "$(location tests/schema_meta_fixtures/{stem}.fbs)".format(stem = stem),
    )
    for stem, deps in [
        ("grandchild_root", ["grandchild_mid", "grandchild_leaf"]),
        ("midns", []),
        ("header_wrong_type", []),
        ("header_right_type", ["header_aorta_sys"]),
        ("enums_only", []),
    ]
]

