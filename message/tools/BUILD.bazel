# Flatc-compiled bfbs fixtures for the loader-backed
# wrapper builders (message/tools/tests/wrapper_loader_fixtures/*.fbs). Plain
# genrules (self-contained schemas, no includes -> no `-I`), same pattern as
# the schema_reflection fixtures below.
[
    genrule(
        name = "wrapper_loader_fixture_{}_bfbs".format(stem),
        srcs = ["tests/wrapper_loader_fixtures/{}.fbs".format(stem)],
        outs = ["tests/wrapper_loader_fixtures/{}.bfbs".format(stem)],
        tools = [":flatc"],
        cmd = "$(location :flatc) --binary --schema --bfbs-builtins -o $(@D) $(location tests/wrapper_loader_fixtures/{}.fbs)".format(stem),
    )
    for stem in [
        "qualified_root",
        "mid_namespace",
        "union_alias",
        "dup_bare_name",
        "same_line_table",
        "commented_ghost",
        "recon_types",
        "union_explicit_values",
        "dup_bare_union",
    ]
]

# `probe_action.fbs` (union alias/target action
# emission port, see gen_message_wrapper_loader_test.py's
# `UnionAliasActionEmissionTest`) needs the gen_action_wrapper expansion step
# (real `include`) before it is flatc-compilable, unlike the other
# self-contained wrapper_loader_fixtures above.
genrule(
    name = "wrapper_loader_fixture_probe_action_expand",
    srcs = ["tests/wrapper_loader_fixtures/probe_action.fbs"],
    outs = ["tests/wrapper_loader_fixtures/probe_action_action/probe_action.fbs"],
    tools = [":gen_action_wrapper"],
    cmd = "$(location :gen_action_wrapper) --root-fbs $(location tests/wrapper_loader_fixtures/probe_action.fbs) --out $@",
)

genrule(
    name = "wrapper_loader_fixture_probe_action_bfbs",
    srcs = [
        ":wrapper_loader_fixture_probe_action_expand",
        "//message/schemas/shared/action_common:action_common.fbs",
    ],
    outs = ["tests/wrapper_loader_fixtures/probe_action_action/probe_action.bfbs"],
    tools = [":flatc"],
    # The expanded schema's `include "schemas/shared/action_common/action_common.fbs";`
    # is qualified (message-root-relative); derive that root by stripping
    # everything from `/schemas/` onward off the real action_common.fbs's own
    # location, same technique as schema_codegen.bzl's `_flatc_cmd`.
    cmd = """
        ACTION_COMMON="$(location //message/schemas/shared/action_common:action_common.fbs)"
        $(location :flatc) --binary --schema --bfbs-builtins \
            -I "$${ACTION_COMMON%%/schemas/*}" \
            -o $(@D) $(location :wrapper_loader_fixture_probe_action_expand)
    """,
)

