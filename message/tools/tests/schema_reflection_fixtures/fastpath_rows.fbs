include "python_fastpath.fbs";
namespace fx_rows;
enum Role : ubyte { UNKNOWN, ACTIVE, RESERVED }
// Motor wire fields from schema revision 71008719f5958df7f09d522f1d585c6748956ce1.
// This isolated fixture retains scalar IDs and the populated thermal vector.
table Motor {
  ts_acquired_hw_us: ulong;
  ts_ingested_us: ulong;
  ts_assembled_us: ulong;
  mode: ubyte;
  q: float;
  dq: float;
  ddq: float;
  tau_est: float;
  q_raw: float;
  dq_raw: float;
  ddq_raw: float;
  temperature: byte;
  lost: uint;
  slot_index: ubyte;
  slot_role: Role;
  accumulated_running_sec: uint;
  thermal_integral: [uint];
  overload_integral: short = -32768;
  mos_temperature_deg_c: short = -32768;
  iq_setpoint_a: float;
  iq_measured_a: float;
}
table Sample {
  signed8: byte;
  unsigned8: ubyte;
  signed16: short;
  unsigned16: ushort;
  signed32: int;
  unsigned32: uint;
  signed64: long;
  unsigned64: ulong;
  real32: float = 0.1;
  real64: double;
}
table Batch {
  motors: [Motor];
  defaults: [fx_fastpath.ScalarDefaults];
  samples: [Sample];
  strings: [string];
}
root_type Batch;
