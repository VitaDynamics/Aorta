// #375 regression fixture: a namespace COMPONENT with a letter->digit boundary.
// flatc snake_cases every namespace component when it emits Rust modules, so
// `namespace p05.probe;` compiles to `pub mod p_05 { pub mod probe { ... } }`.
// A Tier-1 wrapper that spells its Rust paths with a raw `.` -> `::`
// replacement emits `p05::probe::...` and references a module flatc never
// generated -- the crate then fails to compile, which is what the
// `digit_ns_probe_rust_binding` rust_library below exists to catch.
//
// Root-only (no includes), same shape as ../root_only_migration/root_only.fbs.
namespace p05.probe;

table DigitNsProbeData {
  value: int32;
}

root_type DigitNsProbeData;
