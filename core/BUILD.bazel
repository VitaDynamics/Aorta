load("@aorta_crates//:defs.bzl", "all_crate_deps")
load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library", "rust_static_library", "rust_test")
load(":tools/core_abi.bzl", "core_abi_render")

# Bazel deps are sourced from `core/Cargo.toml` via `all_crate_deps`
# (rules_rust crate_universe). Adding a new `[dependencies]` entry to
# `core/Cargo.toml` therefore propagates automatically — eliminating the
# hand-maintained-list footgun that previously required mirroring every
# Cargo dep into a Bazel deps array (cf. unicode-ident / unicode-
# normalization scramble during the keyexpr relaxation work).
rust_library(
    name = "aorta_core",
    srcs = glob(["src/**/*.rs", "test/**/*.rs", "ffi/**/*.rs"], allow_empty = True),
    crate_name = "aorta_core",
    edition = "2021",
    deps = all_crate_deps(normal = True) + ["//sync:aorta_sync"],
    visibility = ["//visibility:public"],
)

# :aorta_core_ffi and :aorta_core_cdylib compile the same crate name as
# "final" artifacts, for which rules_rust passes no `-C metadata`. rustc then
# derives one stable crate id for both and names their codegen-unit temp
# objects identically (`aorta_core.aorta_core.<id>-cgu.N.rcgu.o`) in this
# package's shared out-dir; with the repo's `--spawn_strategy=local` the two
# actions clobber each other's objects whenever they run at the same time
# (truncated / empty / bad-.eh_frame objects at the link step). A distinct
# metadata string per artifact gives each its own crate id and file names.
# It only feeds the Rust symbol hash, never the `#[no_mangle]` C-ABI surface.
rust_static_library(
    name = "aorta_core_ffi",
    srcs = glob(["src/**/*.rs", "test/**/*.rs", "ffi/**/*.rs"], allow_empty = True),
    crate_name = "aorta_core",
    edition = "2021",
    rustc_flags = ["-Cmetadata=aorta_core_ffi"],
    deps = all_crate_deps(normal = True) + ["//sync:aorta_sync"],
    visibility = ["//visibility:public"],
)

# Executor stop-window seam Core: the ONLY target that enables
# the `test-seams` cargo feature (the stop-window pause slot + the
# `aorta_test_stop_window_seam` C symbol). Seam-test binaries link THIS
# target EXCLUSIVELY — never alongside `:aorta_core_ffi` (one Core per
# binary; two registries would split the executor handles). testonly
# keeps it out of every release artifact's dependency closure.
rust_static_library(
    name = "aorta_core_ffi_test_seams",
    testonly = True,
    srcs = glob(["src/**/*.rs", "test/**/*.rs", "ffi/**/*.rs"], allow_empty = True),
    # A DISTINCT crate_name so the staticlib artifact (libaorta_core_seams.a)
    # cannot collide with :aorta_core_ffi's libaorta_core.a in one build
    # graph. The C-ABI surface is #[no_mangle] extern "C" — the crate
    # name never reaches the linker interface.
    crate_name = "aorta_core_seams",
    crate_features = ["test-seams"],
    edition = "2021",
    deps = all_crate_deps(normal = True) + ["//sync:aorta_sync"],
    visibility = ["//visibility:public"],
)

# `AORTA_ABI_VERSION` (src/ffi/c_api/mod.rs) is the only declaration of the
# Core C-ABI generation. This parser is how every artifact that names the ABI
# -- the Linux DT_SONAME below, the SDK bundle's members, CMake package and
# asset name under //tools/release -- derives the number instead of restating
# it (a hand-copied 10 once shipped while Core was at 12).
py_library(
    name = "core_abi_lib",
    srcs = ["tools/core_abi.py"],
    imports = ["tools"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "core_abi",
    srcs = ["tools/core_abi.py"],
    main = "tools/core_abi.py",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "aorta_core_abi_source",
    srcs = ["src/ffi/c_api/mod.rs"],
    visibility = ["//visibility:public"],
)

# rustc reads `@file` argument files; the SONAME flag is rendered from the
# constant so a Core ABI bump re-stamps the library with no edit here.
core_abi_render(
    name = "aorta_core_soname_rustc_args",
    out = "aorta_core_soname.rustc-args",
    text = "-Clink-arg=-Wl,-soname,libaorta_core.so.@AORTA_CORE_ABI_VERSION@",
)

# Python SDK (L3) binds the L2 C-ABI through this cdylib via ctypes —
# see spec/Aorta_Python_SDK_Design_Proposal.md §2/§4. crate_name "aorta_core"
# yields libaorta_core.{so,dylib}, the name the loader (python/aorta/_ffi)
# searches for. A cdylib carries no libpython linkage, so one artifact per
# arch serves every CPython version and cross-compiles to linux aarch64
# (the robot target) cleanly. macOS dev links the same frameworks the
# staticlib FFI tests use (:aorta_core_linkopts).
rust_shared_library(
    name = "aorta_core_cdylib",
    srcs = glob(["src/**/*.rs", "test/**/*.rs", "ffi/**/*.rs"], allow_empty = True),
    compile_data = [":aorta_core_soname_rustc_args"],
    crate_name = "aorta_core",
    edition = "2021",
    # `-Cmetadata`: see :aorta_core_ffi — distinct temp object names.
    rustc_flags = ["-Cmetadata=aorta_core_cdylib"] + select({
        "@platforms//os:linux": ["@$(location :aorta_core_soname_rustc_args)"],
        "@platforms//os:macos": ["-Clink-arg=-Wl,-install_name,@rpath/libaorta_core.dylib"],
        "//conditions:default": [],
    }),
    # Mirror the lib/staticlib deps (incl. //sync:aorta_sync used by
    # core/src/service.rs) + the macOS linkopts.
    deps = all_crate_deps(normal = True) + ["//sync:aorta_sync", ":aorta_core_linkopts"],
    visibility = ["//visibility:public"],
)

