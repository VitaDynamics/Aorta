# ── Cross-language TSAN (Tier 3, single-process Rust + C++) ───────────────────
# `aorta-tsan-xlang.yml` builds the FFI as a TSAN-instrumented staticlib with
# cargo `-Zbuild-std -Zsanitizer=thread` (rules_rust 0.68 can't -Zbuild-std) into
# core/tsan_xlang/ BEFORE `bazel test --config=tsan-xlang`, which flips the define
# below so `//cpp:aorta_cpp` links this prebuilt instead of the uninstrumented
# rules_rust :aorta_core_ffi. Both sides then share one TSAN runtime in one
# process. `manual` keeps the prebuilt out of the normal `//...` build (which has
# no such file and must not require it).
config_setting(
    name = "tsan_xlang",
    values = {"define": "aorta_tsan_xlang=1"},
    visibility = ["//visibility:public"],
)

cc_import(
    name = "_aorta_core_ffi_tsan_archive",
    static_library = "tsan_xlang/libaorta_core_tsan.a",
    tags = ["manual"],
)

cc_library(
    name = "aorta_core_ffi_tsan_prebuilt",
    # rules_rust adds Rust std's link-time system deps automatically for
    # :aorta_core_ffi; the bare prebuilt archive needs them spelled out.
    linkopts = [
        "-lpthread",
        "-ldl",
        "-lm",
        "-lrt",
    ],
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [":_aorta_core_ffi_tsan_archive"],
)

