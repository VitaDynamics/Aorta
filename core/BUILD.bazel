genrule(
    name = "aorta_ffi_header",
    # The driver (//tools/aorta-cbindgen) parses `core/src/lib.rs` directly via
    # cbindgen's `Builder::with_src`, so this action needs the crate's own
    # sources and nothing else — no cargo, no rustc, no workspace manifests.
    #
    # It used to call `Builder::with_crate`, which shells out to
    # `cargo metadata`. cbindgen 0.29 no longer passes `--no-deps` there (see
    # the note atop its `cargo/cargo_metadata.rs`), so every invocation did a
    # FULL dependency resolve — downloading and extracting the entire graph
    # (~1.1 GB) into the throwaway per-action `CARGO_HOME`. That cost ~3 min on
    # a mirrored builder and ~40 min on a proxied cloud runner, on every cache
    # miss, to produce a header derived from
    # `core/src/**` alone. `cbindgen.toml` sets `parse.parse_deps = false`, so
    # the dependency graph was never used for anything.
    srcs = ["cbindgen.toml"] + glob(["src/**/*.rs", "ffi/**/*.rs"], allow_empty = True),
    outs = ["include/aorta.h"],
    # Scoped (not public) visibility: the intended public API is the
    # `:aorta_ffi_headers` cc_library wrapper below. //cpp needs the raw
    # generated file directly (not the cc_library) so the expect-fail
    # sh_test (cpp/BUILD.bazel :flow_expectfail_test) can pull it into its
    # runfiles via `data` — a cc_library's `hdrs` are compile-time only and
    # are not copied into a consuming sh_test's runfiles tree.
    visibility = ["//cpp:__pkg__"],
    tools = ["//tools/aorta-cbindgen:aorta_cbindgen"],
    cmd = "set -e; "
        + "config_rel=$(location cbindgen.toml); "
        + "crate_dir=$$(cd \"$$(dirname \"$$config_rel\")\" && pwd); "
        + "config_path=$$crate_dir/$$(basename \"$$config_rel\"); "
        + "$(execpath //tools/aorta-cbindgen:aorta_cbindgen) --crate-dir $$crate_dir "
        + "--config $$config_path --out $@",
)

